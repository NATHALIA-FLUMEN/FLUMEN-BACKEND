# Puerto del servidor
PORT=4000

# Secreto para firmar tokens JWT (¡cámbialo en producción!)
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRES_IN=7d

# URL base del frontend (para CORS y Google OAuth redirect)
CLIENT_URL=http://localhost:5173

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY_AQUI

# Bucket de Supabase Storage para videos (crear manualmente en Supabase)
SUPABASE_BUCKET=videos

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET_AQUI
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- reCAPTCHA v3 ---
RECAPTCHA_SITE_KEY=TU_RECAPTCHA_SITE_KEY_AQUI
RECAPTCHA_SECRET_KEY=TU_RECAPTCHA_SECRET_KEY_AQUI
RECAPTCHA_MIN_SCORE=0.5

# --- Código maestro para crear el primer administrador ---
MASTER_ADMIN_CODE=FLUMEN-ADMIN-2026

# --- Stripe (acepta todos los métodos de pago) ---
# Modo test: pk_test_... / sk_test_...  (sin mover dinero real)
# Se obtienen en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_TU_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_TU_STRIPE_PUBLISHABLE_KEY
STRIPE_CURRENCY=usd
